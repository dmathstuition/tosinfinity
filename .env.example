# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used only after the requester is verified as Owner.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Scheduled jobs (Vercel Cron sends this as a Bearer token) ----
CRON_SECRET=

# ---- Email. With no provider configured, emails are logged to the server console, not sent. ----
# resend | relay | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# e.g. Tosinfinity Academy <no-reply@yourdomain>
EMAIL_FROM=
# Where new applications are announced
OWNER_NOTIFY_EMAIL=

# ---- Paystack (initial payment provider) ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Also used to verify webhook signatures (x-paystack-signature)
PAYSTACK_SECRET_KEY=

# ---- AI assistant (optional; the app works without it) ----
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Web Push (optional) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Monitoring / analytics (optional) ----
SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Online classes (optional) ----
# Server used when you press "Create online room" (the meeting opens in a new tab).
JITSI_DOMAIN=meet.jit.si
# Optional: host name of your OWN Jitsi server. When set, its meetings open inside the
# lesson room page. Do not set this to meet.jit.si: the public service does not allow
# long embedded calls.
NEXT_PUBLIC_JITSI_EMBED_DOMAIN=

